-- Isolated server-rule checks; no live player or arena is changed.
local module = game:GetService("ServerScriptService").BARA:FindFirstChild("CombatRules")
assert(module, "Phase 3 combat rules have not been implemented")
local Rules = require(module)
local state = Rules.new()
assert(state.hp == 3, "Player must start with 3 HP")
assert(Rules.action(state, 10), "Initial action must work")
assert(not Rules.action(state, 10.49), "Action cooldown must reject early input")
assert(Rules.action(state, 10.5), "Action must work at the 0.5-second boundary")
assert(Rules.damage(state, 20) and state.hp == 2, "Valid damage must remove one HP")
assert(not Rules.damage(state, 20.5) and state.hp == 2, "Invincibility must reject a second hit")
assert(Rules.damage(state, 21.2) and state.hp == 1, "Damage should work after invincibility")
assert(Rules.damage(state, 22.4) and state.hp == 0, "Third valid hit must reach zero")
assert(not Rules.damage(state, 24) and not Rules.action(state, 24), "KO players cannot act or lose more HP")
assert(Rules.inFront(CFrame.new(), Vector3.new(0, 0, -5)), "Front target should be hittable")
assert(not Rules.inFront(CFrame.new(), Vector3.new(0, 0, 5)), "Rear target must be rejected")
assert(not Rules.inFront(CFrame.new(), Vector3.new(0, 0, -7)), "Distant target must be rejected")
assert(not Rules.inFront(CFrame.new(), Vector3.new(0, 7, 0)), "Vertical distance must be checked")
assert(Rules.inside(Vector3.new(0, 3.2, -340)), "Arena center must be valid")
assert(not Rules.inside(Vector3.new(0, 3.2, 72)), "Map spawn is outside the arena")
assert(Rules.new().hp == 3, "Reset must create fresh HP")
return {passed = true, checks = 16}
